<div class="left-right" style="background-color: {{background_color}};">
  {% if flipped %}
      <div class="left-right__wrapper">
        <div class="order-2 md:order-1">
          {% if image.image_path %}
            <div data-editable="image" data-prop-src="image.image_path" data-prop-alt="image.alt_text">
              {% include "components/image", image_path: image.image_path, alt_text: image.alt_text, image_sizes: "(max-width: 640px) 320px, (max-width: 960px) 500px, (max-width: 1280px) 640px" %}
            </div>
          {% endif %}
        </div>
        <div class="left-right__text order-1 md:order-2">
          <h2 class="text-4xl" style="color: {{heading.color}};" data-editable="text" data-type="span" data-prop="heading.heading_text">
            {{heading.heading_text}}
          </h2>
          <div class="mb-4 markdown-text" style="color: {{text.color}};" data-editable="text" data-type="block" data-prop="text.markdown_content">
            {% if text.markdown_content %}{{ text.markdown_content | renderMarkdown }}{% endif %}
          </div>
          {% if button %}
            {% assign _buttonType = button._type %}
            {% includeWith _buttonType, button %}
          {% endif %}
        </div>
      </div>
  {% else %}
      <div class="left-right__wrapper">
        <div class="left-right__text">
          <h2 class="text-4xl" style="color: {{heading.color}};" data-editable="text" data-type="span" data-prop="heading.heading_text">
            {{heading.heading_text}}
          </h2>
          <div class="mb-4 markdown-text" style="color: {{text.color}};" data-editable="text" data-type="block" data-prop="text.markdown_content">
            {% if text.markdown_content %}{{ text.markdown_content | renderMarkdown }}{% endif %}
          </div>
          {% if button %}
            {% assign _buttonType = button._type %}
            {% includeWith _buttonType, button %}
          {% endif %}
        </div>
        <div>
          {% if image.image_path %}
            <div data-editable="image" data-prop-src="image.image_path" data-prop-alt="image.alt_text">
              {% include "components/image", image_path: image.image_path, alt_text: image.alt_text, image_sizes: "(max-width: 640px) 320px, (max-width: 960px) 500px, (max-width: 1280px) 640px" %}
            </div>
          {% endif %}
        </div>
      </div>
    {% endif %}
</div>
